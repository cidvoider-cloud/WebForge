venueLineChart.update()\n        })\n      })\n    </script>\n  </body>\n</html>","jsxCode":"import React from 'react';\n\n/**\n * Charts #1\n * Imported from markmead/hyperui\n */\nexport function Charts1() {\n  return (\n    <div className=\"wf-ui-scope w-full\">\n      <div className=\"rounded-lg border border-gray-200 bg-white p-6\">\n        <div className=\"flex items-center justify-between\">\n          <h2 className=\"text-sm font-medium text-gray-900\">Monthly revenue</h2>\n          <div className=\"inline-flex rounded-md border border-gray-200 p-0.5 text-xs font-medium\">\n            <button\n            type=\"button\"\n            data-revenue-range=\"6m\"\n            aria-pressed=\"true\"\n            className=\"rounded-sm bg-gray-100 px-2 py-1 text-gray-900\"\n          >\n              6M\n            </button>\n            <button\n            type=\"button\"\n            data-revenue-range=\"12m\"\n            aria-pressed=\"false\"\n            className=\"rounded-sm px-2 py-1 text-gray-600\"\n          >\n              12M\n            </button>\n          </div>\n        </div>\n        <div className=\"mt-4 h-64\">\n          <canvas\n          id=\"revenue-line-chart\"\n          role=\"img\"\n          aria-label=\"Monthly revenue, line chart\"\n        ></canvas>\n        </div>\n        <table id=\"revenue-line-chart-table\" className=\"sr-only\" aria-live=\"polite\">\n          <caption>Monthly revenue by month</caption>\n          <thead>\n            <tr>\n              <th scope=\"col\">Month</th>\n              <th scope=\"col\">Revenue</th>\n            </tr>\n          </thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  );\n}\n\nexport default Charts1;\n","code":"import React from 'react';\n\n/**\n * Charts #1\n * Imported from markmead/hyperui\n */\nexport function Charts1() {\n  return (\n    <div className=\"wf-ui-scope w-full\">\n      <div className=\"rounded-lg border border-gray-200 bg-white p